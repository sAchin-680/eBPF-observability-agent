# Generated by bpftool from the running kernel's BTF. ~3MB of kernel struct
# definitions. NOT committed: it is machine-specific and regenerable via
# `make vmlinux`. Committing it would also hide CO-RE bugs, because you'd stop
# noticing when you build against a different kernel's types than you run on.
bpf/vmlinux.h

# bpf2go output: compiled BPF ELF objects + generated Go bindings.
*.o
*_bpfel.go
*_bpfeb.go
*_bpfel_*.go
*_bpfeb_*.go

# Go build output
/bin/
/dist/
*.test
*.out

# Local env
.env
*.local
.DS_Store

# Benchmark scratch (raw results ARE committed under docs/benchmarks/)
/tmp/

# Sample application artifacts: certificates, dependencies, build output.
# Certificates are generated locally by `make -C samples certs`; a repository
# holding a private key teaches the wrong habit even when the key is worthless.
samples/certs/
samples/go-api/go-api
samples/python-flask/.venv/
samples/node-express/node_modules/
samples/node-express/package-lock.json
